#!/usr/bin/env bash
# Attach to the shared persistent tmux session "claude", creating it first if
# needed. The session is created *detached* so it exists independently of any
# client - it survives browser refresh, SSH disconnect and network drops.
# (A full add-on restart still starts fresh; the Claude *login* persists.)
#
# Usage: claude-session [command]   (default command: claude)
set -uo pipefail

export CLAUDE_CONFIG_DIR=/data/claude/.claude
if [ -z "${SUPERVISOR_TOKEN:-}" ] && [ -r /run/s6/container_environment/SUPERVISOR_TOKEN ]; then
    SUPERVISOR_TOKEN="$(cat /run/s6/container_environment/SUPERVISOR_TOKEN)"
    export SUPERVISOR_TOKEN
fi

SESSION="claude"
START_CMD="${1:-claude}"

if ! tmux has-session -t "${SESSION}" 2>/dev/null; then
    cd /homeassistant 2>/dev/null || cd /root
    tmux new-session -d -s "${SESSION}" "${START_CMD}"
fi

# Attach if we have a terminal; otherwise the detached session just keeps running.
if [ -t 1 ]; then
    exec tmux attach-session -t "${SESSION}"
fi
echo "claude-session: '${SESSION}' is running detached (no TTY here to attach to)." >&2
echo "Open the Claude Code sidebar panel, or 'ssh -t ... claude-session', to attach." >&2
