#!/usr/bin/env bash
# Each named terminal has its own persistent tmux session. Switching
# disconnects only a client; the agent's live process keeps running.
# Usage: agent-session [--session ID] [--agent claude|codex|shell] [--workspace ID] [command]
# ttyd uses --web followed by agent, workspace and optional session ID.
set -euo pipefail

MODE=""; WORKSPACE="homeassistant"; START_CMD=""; WEB=false; SESSION_ID=""
if [ "${1:-}" = "--web" ]; then
    WEB=true; shift
    # Separate connections manage metadata and lifecycle, and receive files
    # the page attaches. No URL value is evaluated as a shell command or a
    # path, including on these control connections.
    case "${1:-}" in
        sessions|uploads)
            [ "$#" -eq 1 ] || { echo 'Too many control arguments' >&2; exit 2; }
            exec node "/opt/agent-terminal/$1.mjs" serve ;;
    esac
    [ "$#" -le 3 ] || { echo 'Too many terminal arguments' >&2; exit 2; }
    MODE="${1:-}"; WORKSPACE="${2:-homeassistant}"; SESSION_ID="${3:-}"
else
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --agent|--workspace|--session)
                [ "$#" -ge 2 ] || { echo "Missing value for $1" >&2; exit 2; }
                case "$1" in --agent) MODE="$2" ;; --workspace) WORKSPACE="$2" ;; --session) SESSION_ID="$2" ;; esac
                shift 2 ;;
            --help)
                echo 'Usage: agent-session [--session ID] [--agent claude|codex|shell] [--workspace ID] [command]'; exit 0 ;;
            --*) echo "Unknown option: $1" >&2; exit 2 ;;
            *) [ "$#" -eq 1 ] || { echo 'Quote a custom command as one argument' >&2; exit 2; }; START_CMD="$1"; shift ;;
        esac
    done
fi

if [ -n "${SESSION_ID}" ] && ! "${WEB}"; then
    [ -z "${START_CMD}" ] || { echo 'A named session cannot override its command' >&2; exit 2; }
    SELECTION="$(node /opt/agent-terminal/sessions.mjs get "${SESSION_ID}")"
    MODE="$(jq -r '.agent' <<< "${SELECTION}")"
    WORKSPACE="$(jq -r '.workspace' <<< "${SELECTION}")"
fi

if [ -n "${MODE}" ]; then
    case "${MODE}" in claude|codex|shell|custom) ;; *) echo 'Unknown agent' >&2; exit 2 ;; esac
fi
if [ "${MODE}" = claude ] || [ "${MODE}" = codex ]; then export AGENT="${MODE}"; fi

# shellcheck source=/usr/local/lib/agent.sh
. /usr/local/lib/agent.sh
if [ -z "${SUPERVISOR_TOKEN:-}" ] && [ -r /run/s6/container_environment/SUPERVISOR_TOKEN ]; then
    SUPERVISOR_TOKEN="$(cat /run/s6/container_environment/SUPERVISOR_TOKEN)"
    export SUPERVISOR_TOKEN
fi

if [ -z "${MODE}" ]; then
    MODE="${AGENT}"
    if "${WEB}" && [ -n "$(jq -r '.web_command // empty' /data/options.json)" ]; then MODE=custom; fi
fi
if [ -n "${START_CMD}" ]; then
    MODE=custom
else
    case "${MODE}" in
        shell) START_CMD='bash -l' ;;
        custom) START_CMD="$(jq -r '.web_command // empty' /data/options.json)"
                [ -n "${START_CMD}" ] || { echo 'No custom command configured' >&2; exit 2; } ;;
        *) START_CMD='agent-run' ;;
    esac
fi
# No URL argument is ever interpreted as a command or a filesystem path.
WORKSPACE_JSON="$(agent-workspace get "${WORKSPACE}")"
WORKSPACE_DIR="$(jq -r '.directory' <<< "${WORKSPACE_JSON}")"
[ -d "${WORKSPACE_DIR}" ] || { echo "Workspace directory is missing: ${WORKSPACE_DIR}" >&2; exit 1; }
TMUX_ENV=("AGENT=${AGENT}" "AGENT_WORKSPACE=${WORKSPACE}" "AGENT_WORKSPACE_DIR=${WORKSPACE_DIR}")
while IFS= read -r kv; do
    [ -z "${kv}" ] || TMUX_ENV+=("${kv}")
done < <(agent_all_env)

SESSION="$(node /opt/agent-terminal/sessions.mjs ensure "${MODE}" "${WORKSPACE}" "${SESSION_ID}" "${START_CMD}" "${TMUX_ENV[@]}")"

# Attach if we have a terminal; otherwise the detached session just keeps running.
if [ -t 1 ]; then
    exec tmux attach-session -t "=${SESSION}"
fi
echo "agent-session: '${SESSION}' is running detached (no TTY here to attach to)." >&2
echo "Open the sidebar panel, or 'ssh -t ... agent-session', to attach." >&2
