#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Ingress web terminal. HA authenticates the Ingress session, so ttyd itself
# runs without credentials but is only reachable through Ingress. The command
# runs inside a persistent tmux session for each workspace and agent.

# shellcheck source=/usr/local/lib/agent.sh
. /usr/local/lib/agent.sh

MOBILE_UI="$(jq -r 'if has("mobile_ui") then .mobile_ui else true end' /data/options.json)"
export TERM=xterm-256color
if [ -r /run/s6/container_environment/SUPERVISOR_TOKEN ]; then
    SUPERVISOR_TOKEN="$(cat /run/s6/container_environment/SUPERVISOR_TOKEN)"
    export SUPERVISOR_TOKEN
fi

cd /homeassistant 2>/dev/null || cd /root

# Touch-friendly terminal page (on-screen keys, drag-to-scroll, keyboard-aware
# layout). Falls back to ttyd's stock client if it's switched off or missing.
UI_ARGS=()
if [ "${MOBILE_UI}" = "true" ] && [ -s /run/agent-terminal/index.html ]; then
    UI_ARGS=(--index /run/agent-terminal/index.html)
    echo "[agent-terminal] web terminal: agent and workspace controls enabled"
else
    echo "[agent-terminal] web terminal: stock ttyd UI"
fi

echo "[agent-terminal] web terminal (ttyd) -> persistent workspace sessions"
exec ttyd \
    --port 8099 \
    --interface 0.0.0.0 \
    --writable \
    --url-arg \
    --client-option fontSize=14 \
    --client-option 'rendererType=canvas' \
    --client-option 'titleFixed=Agent Terminal' \
    "${UI_ARGS[@]}" \
    /usr/local/bin/agent-session --web
